# Which LLM backend drives the tester (comprehension, strategy, simulated user, judge).
# One of: scripted | openai_compat | anthropic
# "scripted" is a deterministic offline backend: no keys, no network.
AGENTQA_LLM_PROVIDER=scripted

# --- openai_compat -----------------------------------------------------------
# Works with OpenAI, Ollama (/v1), OpenRouter, vLLM, or any OpenAI-shaped gateway.
# AGENTQA_LLM_PROVIDER=openai_compat
# AGENTQA_LLM_BASE_URL=https://api.openai.com/v1
# AGENTQA_LLM_MODEL=gpt-4o-mini
# AGENTQA_LLM_API_KEY=sk-...

# Local Ollama example (no key needed):
# AGENTQA_LLM_PROVIDER=openai_compat
# AGENTQA_LLM_BASE_URL=http://localhost:11434/v1
# AGENTQA_LLM_MODEL=qwen2.5:7b
# AGENTQA_LLM_API_KEY=ollama

# --- anthropic ---------------------------------------------------------------
# AGENTQA_LLM_PROVIDER=anthropic
# AGENTQA_LLM_MODEL=claude-sonnet-4-20250514
# AGENTQA_LLM_API_KEY=sk-ant-...

# --- shared knobs ------------------------------------------------------------
AGENTQA_LLM_TEMPERATURE=0.7
AGENTQA_LLM_TIMEOUT=120
